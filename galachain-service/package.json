{
  "name": "galachain-service",
  "version": "1.0.0",
  "description": "TypeScript service for GalaChain operations",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "proto": "grpc_tools_node_protoc --js_out=import_style=commonjs,binary:./src/types --grpc_out=grpc_js:./src/types --plugin=protoc-gen-ts=./node_modules/.bin/protoc-gen-ts --ts_out=grpc_js:./src/types -I ../proto ../proto/galachain.proto",
    "test": "jest",
    "test:integration": "jest test/integration.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@gala-chain/gswap-sdk": "^0.0.10",
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "^0.8.0",
    "@types/dotenv": "^6.1.1",
    "@types/node": "^25.0.9",
    "@walletconnect/core": "^2.23.3",
    "@walletconnect/sign-client": "^2.23.3",
    "@walletconnect/utils": "^2.23.3",
    "dotenv": "^17.2.3",
    "qrcode-terminal": "^0.12.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/uuid": "^10.0.0",
    "grpc_tools_node_protoc_ts": "^5.3.3",
    "grpc-tools": "^1.13.1",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6"
  }
}
