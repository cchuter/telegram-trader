# gRPC server port
GRPC_PORT=50051

# Database connection string
DATABASE_URL=postgresql://user:password@localhost:5432/telegram_trader

# Encryption key for sensitive data (32 bytes hex encoded)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# GalaChain GSwap API URL
GSWAP_API_URL=https://swap.gala.com/api

# WalletConnect Project ID (get from https://cloud.walletconnect.com)
WALLETCONNECT_PROJECT_ID=your_project_id_here

# Logging Configuration
# LOG_FORMAT=json (default, for production) or text (for local dev)
LOG_FORMAT=json
