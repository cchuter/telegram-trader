# Telegram Bot Configuration
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Admin User IDs (comma-separated list of Telegram user IDs)
BOT_ADMIN_USER_IDS=123456789,987654321

# Database Configuration
# SQLite for local development:
DATABASE_URL=telegram-trader.db
# PostgreSQL for production:
# DATABASE_URL=postgres://telegram_trader:postgres@localhost:5432/telegram_trader

# Encryption Configuration
# WARNING: For development/POC only! In production, use a secure key management system
# Generate a secure key: openssl rand -base64 32
# This key must be a base64-encoded 32-byte key for AES-256-GCM encryption
ENCRYPTION_KEY=base64-encoded-32-byte-key

# GalaChain Service Configuration
GALACHAIN_SERVICE_URL=localhost:50051
